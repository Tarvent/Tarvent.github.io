---
import { Image } from 'astro:assets';
import type { CollectionEntry } from 'astro:content';
import BaseHead from '../components/BaseHead.astro';
import Comments from '../components/Comments.astro';
import Footer from '../components/Footer.astro';
import FormattedDate from '../components/FormattedDate.astro';
import Header from '../components/Header.astro';

type Props = CollectionEntry<'blog'>['data'] & {
	readingMinutes?: number;
	headings?: Array<{ depth: number; slug: string; text: string }>;
};

const { title, description, pubDate, updatedDate, heroImage, cover, tags, categories, readingMinutes, headings = [] } = Astro.props;
const tableOfContents = headings.filter(({ depth }) => depth >= 1 && depth <= 3);
---

<html lang="zh-CN">
	<head>
		<BaseHead title={title} description={description} />
		<style>
			main {
				width: calc(100% - 2em);
				max-width: 100%;
				margin: 0 auto;
				padding: 4rem 0 5rem;
			}
			.hero-image {
				width: 100%;
			}
			.hero-image img {
				display: block;
				margin: 0 auto;
				border-radius: 12px;
				box-shadow: var(--box-shadow);
			}
			.prose {
				width: 760px;
				max-width: 100%;
				margin: auto;
				padding: 0 1.25rem;
				color: rgb(var(--gray-dark));
			}
			.title {
				margin-bottom: 2.75rem;
				padding: 0;
				text-align: left;
			}
			.title h1 {
				max-width: 18ch;
				margin: 0 0 0.55rem;
				font-size: clamp(1.85rem, 4vw, 2.75rem);
				line-height: 1.08;
				letter-spacing: -0.035em;
			}
			.date {
				margin-bottom: 0.85rem;
				color: rgb(var(--gray));
				font-size: 0.85rem;
			}
			.last-updated-on {
				font-style: italic;
			}
			.article-meta {
				display: flex;
				flex-wrap: wrap;
				gap: .45rem .8rem;
				margin-bottom: .85rem;
				color: rgb(var(--gray));
				font-size: .85rem;
			}
			.article-meta .date { margin: 0; }
			.toc {
				margin: 0 0 2.75rem;
				padding: 1.15rem 1.25rem;
				background: var(--surface);
				border: 1px solid var(--line);
				border-radius: 10px;
			}
			.toc summary { cursor: pointer; font-weight: 700; }
			.toc ol { margin: 1rem 0 0; padding-left: 1.25rem; }
			.toc li { margin: .35rem 0; font-size: .9rem; line-height: 1.45; }
			.toc li.depth-2 { margin-left: .75rem; }
			.toc li.depth-3 { margin-left: 1.5rem; }
			.toc a { color: var(--muted); text-decoration: none; }
			.toc a:hover { color: var(--accent); }
			.prose > :global(h1) {
				margin: 3rem 0 1rem;
				font-size: clamp(1.65rem, 3vw, 2.15rem);
				line-height: 1.25;
				letter-spacing: -0.025em;
			}
			.prose :global(h2) {
				margin: 2.8rem 0 0.9rem;
				font-size: clamp(1.55rem, 3vw, 2rem);
				line-height: 1.25;
				letter-spacing: -0.025em;
			}
			.prose :global(h3) {
				margin: 2.1rem 0 0.75rem;
				font-size: 1.25rem;
				line-height: 1.35;
				letter-spacing: -0.015em;
			}
			.prose :global(p),
			.prose :global(li) {
				font-size: 1.03rem;
				line-height: 1.82;
			}
			.prose :global(p) {
				margin-bottom: 1.25rem;
			}
			.prose :global(ul),
			.prose :global(ol) {
				margin: 0 0 1.5rem;
				padding-left: 1.4rem;
			}
			.prose :global(li + li) {
				margin-top: 0.55rem;
			}
			.prose :global(pre) {
				margin: 1.5rem 0 2rem;
				font-size: 0.9rem;
				line-height: 1.65;
			}
			.prose :global(blockquote) {
				margin: 1.8rem 0;
			}
			@media (max-width: 720px) {
				main { padding: 2.75rem 0 4rem; }
				.title { margin-bottom: 2.25rem; }
				.title h1 { font-size: clamp(1.8rem, 6vw, 2.2rem); }
				.prose :global(p),
				.prose :global(li) { font-size: 1rem; line-height: 1.75; }
			}
		</style>
	</head>

	<body>
		<Header />
		<main>
			<article>
				<div class="hero-image">
					{heroImage && <Image width={1020} height={510} src={heroImage} alt="" />}
				</div>
				<div class="prose">
					<div class="title">
						<p class="eyebrow">{categories?.join(' / ') || 'Note'}</p>
						<div class="article-meta">
							<div class="date"><FormattedDate date={pubDate} /></div>
							{readingMinutes && <span>{readingMinutes} min read</span>}
							{
								updatedDate && (
									<div class="last-updated-on">
										Last updated on <FormattedDate date={updatedDate} />
									</div>
								)
							}
						</div>
						<h1>{title}</h1>
						<p class="description">{description}</p>
						{cover && <img class="cover" src={cover} alt="" />}
						<div>{tags?.map((tag: string) => <span class="tag">{tag}</span>)}</div>
						<hr />
					</div>
					{tableOfContents.length > 1 && (
						<details class="toc" open>
							<summary>On this page</summary>
							<ol>
								{tableOfContents.map((heading) => (
									<li class={`depth-${heading.depth}`}><a href={`#${heading.slug}`}>{heading.text}</a></li>
								))}
							</ol>
						</details>
					)}
					<slot />
					<Comments />
				</div>
			</article>
		</main>
		<Footer />
	</body>
</html>

<style>
	.description { color: var(--muted); }
	.cover { width: 100%; max-height: 390px; object-fit: cover; margin: 1rem 0; }
	.tag { display:inline-block; margin:.5rem .35rem .5rem 0; padding:.18rem .55rem; border-radius:999px; background:var(--accent-soft); color:var(--accent); font-size:.75rem; }
</style>
