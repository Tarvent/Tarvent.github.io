---
import { getCollection } from 'astro:content';
import BaseHead from '../components/BaseHead.astro'; import Footer from '../components/Footer.astro'; import Header from '../components/Header.astro'; import FormattedDate from '../components/FormattedDate.astro';
import { SITE_DESCRIPTION, SITE_TITLE } from '../consts';
const base = import.meta.env.BASE_URL.replace(/\/$/, '');
const posts = (await getCollection('blog', ({ data }) => !data.draft)).sort((a,b) => b.data.pubDate.valueOf() - a.data.pubDate.valueOf());
---
<!doctype html><html lang="zh-CN"><head><BaseHead title={SITE_TITLE} description={SITE_DESCRIPTION} /></head><body><Header /><main>
	<section class="hero"><div><p class="eyebrow">Personal blog</p><h1>Tarvent</h1><p class="intro">Technical notes, side projects, and the occasional detour.</p><div class="actions"><a class="button" href={`${base}/blog`}>Writing</a><a class="button secondary" href={`${base}/projects`}>Projects</a></div></div></section>
	<section class="recent"><div class="section-head"><div><p class="eyebrow">Latest notes</p><h2>最近文章</h2></div><a href={`${base}/blog`}>全部文章 →</a></div><div class="post-grid">{posts.slice(0,6).map(post => <a class="post" href={`${base}/blog/${post.id}/`}><p class="date"><FormattedDate date={post.data.pubDate} /></p><h3>{post.data.title}</h3><p>{post.data.description}</p><div class="tags">{post.data.tags.slice(0,3).map(tag => <span>{tag}</span>)}</div></a>)}</div></section>
</main><Footer /></body></html>
<style>
	.hero{position:relative;min-height:66vh;display:flex;align-items:center;padding-bottom:5rem;border-bottom:1px solid var(--line)}.hero>div{max-width:820px}.hero::after{content:'01';position:absolute;right:0;bottom:4rem;color:var(--surface-2);font-family:ui-monospace,monospace;font-size:clamp(5rem,18vw,13rem);font-weight:800;line-height:.8;z-index:-1}.intro{max-width:650px;margin:1.6rem 0 2rem;color:var(--muted);font-size:1.12rem}.actions{display:flex;gap:.7rem}.recent{padding-top:5rem}.section-head{display:flex;justify-content:space-between;align-items:end;margin-bottom:2rem;padding-bottom:1.5rem;border-bottom:1px solid var(--line)}.section-head a{font-size:.9rem;text-decoration:none}.post-grid{display:grid;grid-template-columns:repeat(3,1fr);gap:1rem}.post{min-height:245px;padding:1.5rem;color:var(--ink);text-decoration:none;background:linear-gradient(145deg,var(--surface-2),var(--surface));border:1px solid var(--line);border-radius:10px;transition:.2s}.post:hover{transform:translateY(-3px);border-color:#3e5749;box-shadow:var(--box-shadow)}.post .date,.post>p{color:var(--muted);font-size:.85rem}.tags{display:flex;flex-wrap:wrap;gap:.35rem;margin-top:1rem}.tags span{padding:.18rem .5rem;background:var(--accent-soft);color:var(--accent);border-radius:999px;font-size:.72rem}@media(max-width:800px){.post-grid{grid-template-columns:1fr}}
</style>
