<span class="view-count" data-view-count aria-live="polite">Views —</span>

<script is:inline>
	(() => {
		const element = document.querySelector('[data-view-count]');
		if (!element) return;

		let attempts = 0;
		const loadCount = async () => {
			attempts += 1;
			if (!window.goatcounter?.get_data) {
				if (attempts < 40) window.setTimeout(loadCount, 150);
				return;
			}

			try {
				const path = window.goatcounter.get_data().p;
				const response = await fetch(`https://tarvent.goatcounter.com/counter/${encodeURIComponent(path)}.json`);
				if (!response.ok) throw new Error('Count unavailable');
				const data = await response.json();
				element.textContent = `${data.count} ${data.count === '1' ? 'view' : 'views'}`;
			} catch {
				element.textContent = 'New';
			}
		};

		loadCount();
	})();
</script>
